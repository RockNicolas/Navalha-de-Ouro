{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": { "gh-pages": false }
  },
  "rewrites": [
    { "source": "/painel", "destination": "/painel/index.html" }
  ],
  "headers": [
    {
      "source": "/painel",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/painel/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
